# Managed PostgreSQL на Timeweb Cloud использует сертификат, которого нет в
# доверенных корневых — добавляйте &uselibpqcompat=true, иначе pg (через
# Prisma-адаптер) будет пытаться проверить цепочку сертификата и упадёт с
# "self-signed certificate in certificate chain".
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&uselibpqcompat=true"

# Секрет для подписи JWT-сессий (сгенерировать случайную строку не короче 32 символов)
JWT_SECRET="change-me"

# Начальный аккаунт тренера (используется сид-скриптом)
TRAINER_USERNAME="trainer"
TRAINER_INITIAL_PASSWORD="change-me"

# S3-совместимое хранилище файлов (Timeweb Cloud → Облачное хранилище → S3).
# Бакет может быть полностью приватным — файлы отдаются только через
# авторизованные API-роуты приложения, наружу прямых ссылок нет.
S3_ENDPOINT="https://s3.timeweb.cloud"
S3_REGION="ru-1"
S3_BUCKET="change-me"
S3_ACCESS_KEY_ID="change-me"
S3_SECRET_ACCESS_KEY="change-me"

# Ключ файла бланка договора в S3-хранилище (после переноса — путь вида
# "contract-template/dogovor.docx"), необязательно.
CONTRACT_TEMPLATE_URL=""

# Push-уведомления родителям (необязательно, без них просто не отправляются).
# Сгенерировать пару: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Ссылка на оплату через СБП (генерируется в интернет-банке школы,
# QR можно сохранить как public/sbp-qr.png). Необязательно — без неё
# карточка оплаты просто не показывает кнопку/QR.
NEXT_PUBLIC_SBP_LINK=""

# Канонический домен — редиректит на него все остальные (полезно, если у
# хостинга есть служебные алиасы вроде git-branch/preview-адресов). Необязательно.
CANONICAL_HOST=""
